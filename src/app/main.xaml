<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d">
	<Window.SystemBackdrop>
		<MicaBackdrop Kind="BaseAlt"/>
	</Window.SystemBackdrop>
	<Grid>
   	 <Frame x:Name="ContentFrame" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
		<StackPanel>
			<InfoBar Background="Black" IsClosable="False" Name="exit" IsOpen="False" Severity="Informational" Title="Press Alt-F4 to exit" />
		</StackPanel>
	</Grid>
</Window>
